+    return {'version':'3.12','scope':'DESIGN_DOCUMENTATION_ONLY','nativeTestsExecuted':False,'checks':checks,'contrastPairs':actual,'scenes':len(scenes),'illustratedScreenReferences':16,'notDrawnScreenReferences':33,'passed':not errors,'errors':errors,'limits':['Opaque sRGB contrast only; no global WCAG certification.','Screenshots are browser compositions, not SwiftUI, MapKit or device tests.','Business rules and native behaviour are not exercised by these checks.']}
