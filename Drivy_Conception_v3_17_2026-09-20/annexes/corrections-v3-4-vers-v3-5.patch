+ '06-gouvernance/audit-corrections-v3-1.md','06-gouvernance/audit-corrections-v3-2.md',
+}
+PATTERN=re.compile(r'\bExpo\b|\bRN\b|React Native|expo-location|expo-maps|expo-sqlite|\bEAS\b|\bSecureStore\b|\bAsyncStorage\b')
+def check(root=ROOT):
+ errors=[];tests=[]
