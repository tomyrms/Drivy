+  try:
+   result=subprocess.run(cmd,cwd=R,capture_output=True,text=True,encoding='utf-8',errors='replace',timeout=a.timeout,env=env)
+   try:payload=json.loads(result.stdout)
+   except json.JSONDecodeError:payload={'passed':False,'error':'Non-JSON output','stdoutTail':result.stdout[-3000:]}
+   ok=result.returncode==0 and payload.get('passed') is True
+   record={'script':script,'status':'PASSED' if ok else 'FAILED','exitCode':result.returncode,'passed':ok,'scope':payload.get('scope',payload.get('status')),'errorCount':payload.get('errorCount',len(payload.get('errors',[]))),'errors':payload.get('errors',[]),'stderr':result.stderr[-5000:]}
+  except (subprocess.TimeoutExpired,OSError) as exc:record={'script':script,'status':'FAILED','passed':False,'error':str(exc)}
