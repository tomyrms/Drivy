+#!/usr/bin/env python3
+"""Explicit, fail-closed runner for the current documentary release; not product tests."""
+from __future__ import annotations
+import argparse,datetime,json,os,subprocess,sys
+from pathlib import Path
+R=Path(__file__).resolve().parents[1]
+CORE=['verifier-environnement.py','verifier-documentation.py','verifier-reference-v3-11.py','verifier-fichiers-v3-11.py','verifier-mobile-swift-v3-11.py','verifier-design-v3-11.py']
