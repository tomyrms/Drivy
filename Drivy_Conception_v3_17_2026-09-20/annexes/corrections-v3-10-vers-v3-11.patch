+r=ns['check'](False);r['version']='3.11';r['currentContractVersion']='3.11.0';r['adaptation']='Current versions and new contiguous T IDs only; substantive inherited checks retained. New file-specific checks run separately.'
+p=argparse.ArgumentParser();p.add_argument('--write-report',action='store_true');args=p.parse_args()
+if args.write_report:(R/'annexes/verification-reference-v3-11.json').write_text(json.dumps(r,ensure_ascii=False,indent=2)+'\n', encoding="utf-8")
+print(json.dumps(r,ensure_ascii=False,indent=2));raise SystemExit(0 if r['passed'] else 1)
