+  if script in BROWSER and not a.browser:reports.append({'script':script,'status':'NOT_RUN','passed':None,'reason':'Use --browser after installing requirements-browser.txt and Chromium.'});continue
+  cmd=[sys.executable,str(R/'annexes'/script)]
