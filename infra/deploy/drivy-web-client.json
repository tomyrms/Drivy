{
  "clientId": "drivy-web",
  "name": "Drivy web",
  "enabled": true,
  "protocol": "openid-connect",
  "clientAuthenticatorType": "client-secret",
  "publicClient": false,
  "standardFlowEnabled": true,
  "directAccessGrantsEnabled": false,
  "implicitFlowEnabled": false,
  "serviceAccountsEnabled": false,
  "fullScopeAllowed": false,
  "redirectUris": ["https://drivy.shulker.ch/app/bff/callback"],
  "webOrigins": [],
  "attributes": {"pkce.code.challenge.method": "S256"},
  "defaultClientScopes": ["basic", "profile", "email"],
  "optionalClientScopes": [],
  "protocolMappers": [{
    "name": "drivy-api-audience",
    "protocol": "openid-connect",
    "protocolMapper": "oidc-audience-mapper",
    "consentRequired": false,
    "config": {"included.custom.audience": "drivy-api", "id.token.claim": "false", "access.token.claim": "true", "introspection.token.claim": "true"}
  }]
}
