[Unit]
Description=Drivy refonte - service des cours et notifications push
After=network-online.target drivy-refonte-ingress.service
Requires=drivy-refonte-ingress.service
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=drivy-course-worker
Group=drivy-course-worker
WorkingDirectory=/opt/drivy-refonte/current/apps/api
EnvironmentFile=/etc/drivy-refonte/course-worker.env
EnvironmentFile=/etc/drivy-refonte/course-push.env
Environment=NODE_OPTIONS=--max-old-space-size=128
ExecStart=/opt/drivy-refonte/runtime/node/bin/node dist/course-worker.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
MemoryHigh=192M
MemoryMax=256M
TasksMax=64
UMask=0077
NoNewPrivileges=true
# CT114 interdit les namespaces de montage systemd ; compte sans privilège,
# code/configuration non modifiables et confinement LXC restent effectifs.
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitCORE=0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
