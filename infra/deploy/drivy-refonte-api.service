[Unit]
Description=Drivy refonte - lectures API G1A
After=network-online.target drivy-refonte-ingress.service
Requires=drivy-refonte-ingress.service
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=drivy-refonte
Group=drivy-refonte
WorkingDirectory=/opt/drivy-refonte/current/apps/api
EnvironmentFile=/etc/drivy-refonte/api.env
Environment=NODE_OPTIONS=--max-old-space-size=128
ExecStart=/opt/drivy-refonte/runtime/node/bin/node dist/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
MemoryHigh=192M
MemoryMax=256M
TasksMax=64
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitCORE=0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
