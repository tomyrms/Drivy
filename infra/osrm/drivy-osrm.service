[Unit]
Description=Drivy OSRM v26.10.0 Suisse, reseau prive seulement
After=network-online.target nftables.service
Wants=network-online.target
Requires=nftables.service

[Service]
User=osrm
Group=osrm
ExecStart=/opt/osrm/v26.10.0/osrm-routed --algorithm mld --ip 192.168.1.158 --port 5000 --threads 2 --max-matching-size 100 /srv/osrm/current/switzerland-latest.osrm
Restart=always
RestartSec=3
NoNewPrivileges=yes
MemoryMax=1200M
LimitCORE=0
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
