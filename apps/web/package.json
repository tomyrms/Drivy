{
  "name": "@drivy/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/main.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "start": "node dist/server/main.js"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fastify": "5.12.6",
    "lucide-react": "1.63.0",
    "openid-client": "6.8.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.0",
    "typescript": "5.9.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
