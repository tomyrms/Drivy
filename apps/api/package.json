{
  "name": "@drivy/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/auth.test.ts test/cursor.test.ts test/invitation-code.test.ts test/capture-anchoring.test.ts test/request-hardening.test.ts test/track-matching.test.ts test/next-slot.test.ts test/observation-ranking.test.ts test/school-metrics-model.test.ts test/platform-model.test.ts test/platform-contract.test.ts test/platform-clients-model.test.ts test/platform-clients-contract.test.ts test/entitlements-model.test.ts test/platform-offers-model.test.ts test/platform-offers-contract.test.ts",
    "migrate": "tsx scripts/migrate.ts",
    "operators:bootstrap": "tsx scripts/operators-bootstrap.ts",
    "seed": "tsx scripts/seed.ts",
    "mail:worker": "node dist/invitation-mail-worker.js",
    "mail:worker:dev": "tsx src/invitation-mail-worker.ts",
    "course:worker": "node dist/course-worker.js",
    "billing:worker": "node dist/billing-worker.js",
    "billing:mail": "node dist/billing-mail-worker.js",
    "billing:mail:dev": "tsx src/billing-mail-worker.ts"
  },
  "dependencies": {
    "fastify": "5.12.6",
    "jose": "^6.1.0",
    "nodemailer": "10.1.4",
    "pdfkit": "0.20.2",
    "pg": "^8.16.3",
    "swissqrbill": "4.4.4",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "^8.15.5",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vitest": "5.0.5",
    "yaml": "^2.8.1"
  }
}
