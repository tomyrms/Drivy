{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:drivy:contract:messaging-media:1",
  "title": "Médias chiffrés de bout en bout de la messagerie (#97)",
  "description": "PUT/GET/DELETE /v1/schools/{schoolId}/messaging/conversations/{conversationId}/media/{mediaId} et champ media du POST messages. Le dossier de conception 3.11.0 reste immuable : aucune route n’y est ajoutée, ce fichier est le contrat exécutable. Les octets sont chiffrés par l’appareil et opaques pour le serveur : le serveur ne stocke ni nom, ni type MIME, ni légende, ni clé, ni IV, ni miniature, seulement identifiant, école, conversation, déposant, taille, SHA-256 du chiffré, octets, horodatages, état et message porteur. Un média est UPLOADED (octets sans message), ATTACHED (octets et message) ou PURGED (sans octets, marque de suppression conservée) ; PURGED est terminal. GET répond application/octet-stream avec Cache-Control private, no-store et X-Drivy-Media-Sha256, ou un 404 MEDIA_NOT_FOUND uniforme. Le téléchargement relit la plage de séquence du lien, le masquage, la suppression et l’appareil déclaré actif ; la révocation est une garantie de compte.",
  "$defs": {
    "MediaPutBody": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4194304,
      "description": "Octets chiffrés bruts, Content-Type application/octet-stream, Content-Length obligatoire et égal à la taille reçue."
    },
    "MediaUploadResponse": {
      "type": "object",
      "properties": {
        "mediaId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "byteSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "state": {
          "type": "string",
          "enum": [
            "UPLOADED",
            "ATTACHED",
            "PURGED"
          ]
        }
      },
      "required": [
        "mediaId",
        "byteSize",
        "sha256",
        "state"
      ],
      "additionalProperties": false
    },
    "MediaCancelResponse": {
      "type": "object",
      "properties": {
        "mediaId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "deleted": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "mediaId",
        "deleted"
      ],
      "additionalProperties": false
    },
    "MediaMessage": {
      "type": "object",
      "properties": {
        "mediaId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "byteSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "deleted": {
          "type": "boolean"
        }
      },
      "required": [
        "mediaId",
        "byteSize",
        "deleted"
      ],
      "additionalProperties": false
    },
    "MediaError": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "code": {
          "type": "string",
          "enum": [
            "INVALID_MEDIA",
            "PAYLOAD_TOO_LARGE",
            "MESSAGING_DEVICE_REQUIRED",
            "MEDIA_NOT_FOUND",
            "MEDIA_INTENT_CONFLICT",
            "MEDIA_ALREADY_ATTACHED",
            "MEDIA_SIZE_MISMATCH",
            "MEDIA_PURGED",
            "MESSAGING_NOT_ENABLED"
          ]
        },
        "requestId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        }
      },
      "required": [
        "type",
        "title",
        "status",
        "code",
        "requestId"
      ],
      "additionalProperties": false
    }
  }
}
