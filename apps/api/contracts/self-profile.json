{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:drivy:contract:self-profile:3",
  "$comment": "Extension du 21 octobre 2026 (issue #64). Profil personnel de la personne connectée, quel que soit son rôle : données du compte Drivy, distinctes du dossier d'élève d'une école et de l'adresse de connexion (fournisseur d'identité). OpenAPI canonique 3.11.0 conservé. GET /v1/me/profile ; PATCH /v1/me/profile (If-Match : version de la personne ; un champ absent reste inchangé, null ou vide l'efface ; un renvoi identique répond 200 sans incrémenter) ; PUT /v1/me/profile/photo (corps image/jpeg, 64 à 1024 px par côté, 256 Kio au plus après nettoyage ; EXIF, XMP, ICC et commentaires retirés ; chiffré AES-256-GCM) ; DELETE /v1/me/profile/photo ; GET /v1/people/{personId}/photo (image/jpeg, soi-même ou membre actif d'une même école, sinon 404). Refus : 412 VERSION_CONFLICT, 428 PRECONDITION_REQUIRED, 400 INVALID_REQUEST, 415, 422 PHOTO_INVALID, 503 PHOTO_STORAGE_UNAVAILABLE, 403 IDENTITY_NOT_LINKED.",
  "$defs": {
    "PostalAddress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line1", "postalCode", "locality", "countryCode"],
      "properties": {
        "line1": {"type": "string", "minLength": 1, "maxLength": 200},
        "line2": {"type": ["string", "null"], "maxLength": 200},
        "postalCode": {"type": "string", "minLength": 1, "maxLength": 20},
        "locality": {"type": "string", "minLength": 1, "maxLength": 150},
        "countryCode": {"type": "string", "pattern": "^[A-Z]{2}$"}
      }
    },
    "SelfProfileUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName"],
      "properties": {
        "displayName": {"type": "string", "minLength": 1, "maxLength": 200, "description": "Espaces de bord retirés, normalisé NFC, sans caractère de contrôle."},
        "firstName": {"type": ["string", "null"], "maxLength": 150},
        "lastName": {"type": ["string", "null"], "maxLength": 150},
        "contactPhone": {"type": ["string", "null"], "maxLength": 32, "pattern": "^[+0-9 ().\\-/]{3,32}$"},
        "contactEmail": {"type": ["string", "null"], "format": "email", "maxLength": 254, "description": "E-mail de contact, jamais l'adresse de connexion."},
        "birthDate": {"type": ["string", "null"], "format": "date", "description": "Date civile entre 1900-01-01 et aujourd'hui (Europe/Zurich)."},
        "postalAddress": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/PostalAddress"}]}
      }
    },
    "SelfProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["personId", "displayName", "firstName", "lastName", "contactPhone", "contactEmail", "birthDate", "postalAddress", "photoVersion", "version"],
      "properties": {
        "personId": {"type": "string", "format": "uuid"},
        "displayName": {"type": "string", "minLength": 1, "maxLength": 200},
        "firstName": {"type": ["string", "null"]},
        "lastName": {"type": ["string", "null"]},
        "contactPhone": {"type": ["string", "null"]},
        "contactEmail": {"type": ["string", "null"]},
        "birthDate": {"type": ["string", "null"], "format": "date"},
        "postalAddress": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/PostalAddress"}]},
        "photoVersion": {"type": ["integer", "null"], "minimum": 1, "description": "null : aucune photo, les initiales s'affichent."},
        "version": {"type": "integer", "minimum": 1}
      }
    },
    "SelfProfileEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "requestId", "serverTime"],
      "properties": {
        "data": {"$ref": "#/$defs/SelfProfile"},
        "requestId": {"type": "string", "format": "uuid"},
        "serverTime": {"type": "string", "format": "date-time"}
      }
    }
  }
}
